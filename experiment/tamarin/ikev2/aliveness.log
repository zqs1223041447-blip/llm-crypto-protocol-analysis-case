rule (modulo E) IKE_AUTH_COMPLETE:
   [
   In( <spiI, spiR, 'IKE_AUTH', '2', 'r', 
        senc(<idR, spiC, auth_pl_R, pkR>, keymat), 
        hmac(<spiI, spiR, 'IKE_AUTH', '2', 'r', 
              senc(<idR, spiC, auth_pl_R, pkR>, keymat)>,
             keymat)
       >
   ),
   StateAuthI( $I, $R, idI, spiI, spiR, nI, nR, keymat, msg1, msg2, epI, epR
   ),
   !PubKey( $R, pkR )
   ]
  --[
  Eq( verify(auth_pl_R, <msg2, nI, h(<idR, keymat>)>, pkR), true ),
  IKeys( $I, $R, spiC, hmac(keymat, <nI, nR>) ),
  Completed( <spiI, spiR>, $I, 'initiator', $R, keymat ),
  IdentityLearnt( idI )
  ]->
   [
   Out( <'0', senc('test', hmac(keymat, <nI, nR>)), 
         hmac(<'0', senc('test', hmac(keymat, <nI, nR>))>, hmac(keymat, <nI, nR>))
        >
   )
   ]

