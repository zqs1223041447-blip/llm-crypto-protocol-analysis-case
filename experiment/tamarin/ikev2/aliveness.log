lemma aliveness [use_induction]:
  all-traces
  "∀ spi I R keymat #i.
    ((Completed( spi, I, 'initiator', R, keymat ) @ #i) ∧
     (¬(∃ #k. RevLtk( R ) @ #k))) ⇒
    (∃ spi2 peer role keymat2 #j.
      (Completed( spi2, R, role, peer, keymat2 ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ spi I R keymat #i.
  (Completed( spi, I, 'initiator', R, keymat ) @ #i)
 ∧
  (∀ #k. (RevLtk( R ) @ #k) ⇒ ⊥) ∧
  (∀ spi2 peer role keymat2 #j.
    (Completed( spi2, R, role, peer, keymat2 ) @ #j) ⇒ ¬(#j < #i))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (last(#i))  ∥ (∃ #k. (RevLtk( R ) @ #k) ∧ ¬(last(#k)))  ∥
         (∃ spi2 peer role keymat2 #j.
           (Completed( spi2, R, role, peer, keymat2 ) @ #j)
          ∧
           (¬(last(#j))) ∧ (#j < #i)) )
    case case_1
    solve( Completed( spi, I, 'initiator', R, keymat ) @ #i )
      case IKE_AUTH_COMPLETE
      solve( StateAuthI( $I, $R, idI, spiI, spiR, nI, nR, keymat, msg1, msg2,
                         epI, epR
             ) ▶₁ #i )
        case IKE_AUTH_I
        solve( !PubKey( $R, pk(x) ) ▶₂ #i )
          case generate_static
          solve( !KU( senc(<idR, spiC, 
                            sign(<<~spiI, spiR, 'IKE_SA_INIT', '1', 'r', epR, nR>, ~nI, 
                                  h(<idR, h(<<~nI, nR>, z>)>)>,
                                 ~ltk), 
                            pk(~ltk)>,
                           h(<<~nI, nR>, z>))
                 ) @ #vk.15 )
            case IKE_AUTH_R
            by contradiction /* from formulas */
          next
            case c_senc
            solve( !KU( h(<<~nI, nR>, z>) ) @ #vk.24 )
              case c_h
              solve( !KU( sign(<<~spiI, spiR, 'IKE_SA_INIT', '1', 'r', epR, nR>, ~nI, 
                                h(<idR, h(<<~nI, nR>, z>)>)>,
                               ~ltk)
                     ) @ #vk.30 )
                case IKE_AUTH_R
                by contradiction /* from formulas */
              next
                case c_sign
                solve( !KU( ~ltk ) @ #vk.37 )
                  case reveal_static
                  by contradiction /* from formulas */
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  next
    case case_2
    by contradiction /* from formulas */
  next
    case case_3
    by contradiction /* from formulas */
  qed
qed

